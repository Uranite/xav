+    function(avm_apply_p1_patch TARGET_DIR PATCH_FILE STAMP_FILE)
+      if(EXISTS "${STAMP_FILE}"
+         AND NOT "${PATCH_FILE}" IS_NEWER_THAN "${STAMP_FILE}")
+        return()
+      endif()
+      get_filename_component(_avm_patch_name "${PATCH_FILE}" NAME)
+      set(_avm_patch_copy "${CMAKE_BINARY_DIR}/avm_patches/${_avm_patch_name}")
+      file(READ "${PATCH_FILE}" _avm_patch_text)
+      string(REPLACE "\r\n" "\n" _avm_patch_text "${_avm_patch_text}")
+      file(WRITE "${_avm_patch_copy}" "${_avm_patch_text}")
+      execute_process(
+        COMMAND "${AVM_PATCH_PROGRAM}" -p1 -N --forward -i "${_avm_patch_copy}"
+        WORKING_DIRECTORY "${TARGET_DIR}"
+        RESULT_VARIABLE _avm_patch_result
+        OUTPUT_VARIABLE _avm_patch_out
+        ERROR_VARIABLE _avm_patch_err)
+      if(NOT _avm_patch_result EQUAL 0)
+        file(REMOVE "${STAMP_FILE}")
+        message(
+          FATAL_ERROR
+            "Failed to apply ${PATCH_FILE} in ${TARGET_DIR}:\n${_avm_patch_err}\n${_avm_patch_out}"
+        )
+      endif()
+      file(WRITE "${STAMP_FILE}" "patched by avm build\n")
+    endfunction()
+
+    function(avm_extract_tarball ARCHIVE PARENT_DIR DEST_DIR READY_MARKER)
+      if(NOT EXISTS "${ARCHIVE}")
+        message(FATAL_ERROR "Missing TFLite dependency archive: ${ARCHIVE}")
+      endif()
+      if(EXISTS "${READY_MARKER}"
+         AND EXISTS "${DEST_DIR}"
+         AND NOT "${ARCHIVE}" IS_NEWER_THAN "${READY_MARKER}")
+        return()
+      endif()
+      message(STATUS "Extracting ${ARCHIVE} ...")
+      file(REMOVE_RECURSE "${DEST_DIR}")
+      file(MAKE_DIRECTORY "${PARENT_DIR}")
+      execute_process(
+        COMMAND "${CMAKE_COMMAND}" -E tar xzf "${ARCHIVE}"
+        WORKING_DIRECTORY "${PARENT_DIR}"
+        RESULT_VARIABLE _avm_tar_result
+        OUTPUT_VARIABLE _avm_tar_out
+        ERROR_VARIABLE _avm_tar_err)
+      if(NOT _avm_tar_result EQUAL 0)
+        file(REMOVE_RECURSE "${DEST_DIR}")
+        file(REMOVE "${READY_MARKER}")
+        message(
+          FATAL_ERROR "Failed to extract ${ARCHIVE}:\n${_avm_tar_err}\n${_avm_tar_out}"
+        )
+      endif()
+      if(NOT EXISTS "${DEST_DIR}")
+        file(REMOVE "${READY_MARKER}")
+        message(
+          FATAL_ERROR
+            "Failed to extract ${ARCHIVE}: expected directory ${DEST_DIR} was not created."
+        )
+      endif()
+      file(WRITE "${READY_MARKER}" "extracted by avm build\n")
+    endfunction()
